{
  "name": "CoverageSetting",
  "type": "object",
  "properties": {
    "area": {
      "type": "string",
      "title": "Area"
    },
    "days": {
      "type": "array",
      "title": "Per-day coverage windows (index 0=Sun .. 6=Sat)",
      "items": {
        "type": "object",
        "properties": {
          "windows": {
            "type": "array",
            "default": [],
            "items": {
              "type": "object",
              "properties": {
                "start": {
                  "type": "number",
                  "title": "Start (minutes from midnight)"
                },
                "end": {
                  "type": "number",
                  "title": "End (minutes from midnight)"
                },
                "min": {
                  "type": "number",
                  "title": "Minimum staff on floor"
                }
              }
            }
          }
        }
      },
      "default": []
    }
  },
  "required": [
    "area"
  ]
}